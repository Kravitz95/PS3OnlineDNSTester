public class UpnpTester {

    public static class Result {
        public String status = "NO DETERMINADO";

        /*
         * Estados del mapeo:
         * NO
         * SOLICITADO
         * CREADO
         * VERIFICADO
         * RECHAZADO
         * NO DETERMINADO
         */
        public String mapping = "NO";

        /*
         * Renovación:
         * OK / FALLIDA / NO DETERMINADA
         */
        public String renewal = "NO DETERMINADA";

        /*
         * Eliminación:
         * OK / FALLIDA / NO DETERMINADA
         */
        public String removal = "NO DETERMINADA";

        public long leaseSeconds = 0;

        public boolean upnpDetected = false;
        public boolean mappingAttempted = false;
        public boolean mappingVerified = false;
        public boolean routerRejected = false;
        public boolean indeterminate = true;

        public int testedPort = -1;
        public String localAddress = null;
        public String controlUrl = null;
        public String serviceType = null;
        public String error = null;
    }

    private static class ControlInfo {
        String controlUrl;
        String serviceType;

        ControlInfo(String controlUrl, String serviceType) {
            this.controlUrl = controlUrl;
            this.serviceType = serviceType;
        }
    }

    private static class SoapResult {
        boolean success;
        int httpCode;
        String body;
        String error;

        SoapResult(boolean success, int httpCode, String body, String error) {
            this.success = success;
            this.httpCode = httpCode;
            this.body = body;
            this.error = error;
        }
    }

    public static Result test(Context context, long waitMillis) {
        Result result = new Result();

        int port = 45000 + new Random().nextInt(1000);
        result.testedPort = port;

        try {
            /*
             * 1. Descubrir IGD mediante SSDP.
             */
            String location = discover();

            if (location == null) {
                result.status = "NO UPnP";
                result.error = "No se detectó un gateway UPnP.";
                result.indeterminate = false;
                return result;
            }

            result.upnpDetected = true;

            /*
             * 2. Obtener descripción del dispositivo.
             */
            String xml = get(location);

            if (xml == null || xml.trim().isEmpty()) {
                result.status = "UPnP DETECTADO · DESCRIPCIÓN NO DISPONIBLE";
                result.error = "El gateway respondió pero no se pudo obtener su descripción.";
                result.indeterminate = true;
                return result;
            }

            /*
             * 3. Buscar WANIPConnection o WANPPPConnection.
             */
            ControlInfo control = control(location, xml);

            if (control == null) {
                result.status = "UPnP DETECTADO · SERVICIO WAN NO DISPONIBLE";
                result.error = "No se encontró WANIPConnection ni WANPPPConnection.";
                result.indeterminate = true;
                return result;
            }

            result.controlUrl = control.controlUrl;
            result.serviceType = control.serviceType;

            /*
             * 4. Obtener IPv4 local.
             */
            String localIp = localIp();
            result.localAddress = localIp;

            /*
             * 5. Solicitar mapeo.
             */
            String args =
                    "<NewRemoteHost></NewRemoteHost>" +
                    "<NewExternalPort>" + port + "</NewExternalPort>" +
                    "<NewProtocol>UDP</NewProtocol>" +
                    "<NewInternalPort>" + port + "</NewInternalPort>" +
                    "<NewInternalClient>" + localIp + "</NewInternalClient>" +
                    "<NewEnabled>1</NewEnabled>" +
                    "<NewPortMappingDescription>PS3 ONLINE DNS TEST</NewPortMappingDescription>" +
                    "<NewLeaseDuration>3600</NewLeaseDuration>";

            result.mappingAttempted = true;

            SoapResult add = soap(
                    control,
                    "AddPortMapping",
                    args
            );

            /*
             * IMPORTANTE:
             * Fallar AddPortMapping NO significa DISPONIBLE.
             */
            if (!add.success) {
                result.mapping = "RECHAZADO";
                result.routerRejected = true;
                result.indeterminate = false;
                result.status = "UPnP DETECTADO · ROUTER RECHAZÓ EL MAPE0";
                result.error = buildSoapError(add);

                return result;
            }

            result.mapping = "CREADO";

            /*
             * 6. Verificar que el mapeo realmente exista.
             */
            String query =
                    "<NewRemoteHost></NewRemoteHost>" +
                    "<NewExternalPort>" + port + "</NewExternalPort>" +
                    "<NewProtocol>UDP</NewProtocol>";

            SoapResult verify = soap(
                    control,
                    "GetSpecificPortMappingEntry",
                    query
            );

            if (!verify.success) {
                result.mapping = "NO DETERMINADO";
                result.status = "UPnP DETECTADO · MAPE0 NO VERIFICADO";
                result.error = "El router aceptó la solicitud pero no se pudo verificar el mapeo.";
                result.indeterminate = true;
                return result;
            }

            /*
             * El mapeo fue creado y consultado correctamente.
             */
            result.mapping = "VERIFICADO";
            result.mappingVerified = true;
            result.indeterminate = false;
            result.status = "UPnP · MAPE0 VERIFICADO";

            result.leaseSeconds = parse(
                    verify.body,
                    "NewLeaseDuration"
            );

            /*
             * 7. Esperar solo el tiempo solicitado, con límite.
             */
            long safeWait = Math.max(0, Math.min(waitMillis, 15000));

            if (safeWait > 0) {
                Thread.sleep(safeWait);
            }

            /*
             * 8. Renovar.
             */
            SoapResult renew = soap(
                    control,
                    "AddPortMapping",
                    args
            );

            result.renewal = renew.success
                    ? "OK"
                    : "FALLIDA";

            /*
             * 9. Eliminar el mapeo creado por esta prueba.
             */
            SoapResult remove = soap(
                    control,
                    "DeletePortMapping",
                    query
            );

            result.removal = remove.success
                    ? "OK"
                    : "FALLIDA";

            return result;

        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();

            result.status = "UPnP · PRUEBA INTERRUMPIDA";
            result.error = "La prueba fue interrumpida.";
            result.indeterminate = true;

            return result;

        } catch (Exception e) {
            result.status = "UPnP · ERROR";
            result.error = e.getClass().getSimpleName() +
                    ": " + safeMessage(e);
            result.indeterminate = true;

            return result;
        }
    }

    public static String discover() throws Exception {
        DatagramSocket socket = new DatagramSocket();
        socket.setSoTimeout(2500);

        String message =
                "M-SEARCH * HTTP/1.1\r\n" +
                "HOST: 239.255.255.250:1900\r\n" +
                "MAN: \"ssdp:discover\"\r\n" +
                "MX: 2\r\n" +
                "ST: urn:schemas-upnp-org:device:InternetGatewayDevice:1\r\n" +
                "\r\n";

        byte[] data = message.getBytes(StandardCharsets.UTF_8);

        DatagramPacket packet = new DatagramPacket(
                data,
                data.length,
                InetAddress.getByName("239.255.255.250"),
                1900
        );

        socket.send(packet);

        byte[] buffer = new byte[8192];

        DatagramPacket response = new DatagramPacket(
                buffer,
                buffer.length
        );

        try {
            socket.receive(response);
        } catch (Exception e) {
            socket.close();
            return null;
        }

        socket.close();

        String text = new String(
                response.getData(),
                0,
                response.getLength(),
                StandardCharsets.UTF_8
        );

        for (String line : text.split("\r\n")) {
            if (line.toLowerCase().startsWith("location:")) {
                return line.substring(9).trim();
            }
        }

        return null;
    }

    private static String get(String url) throws Exception {
        HttpURLConnection connection =
                (HttpURLConnection) new URL(url).openConnection();

        connection.setConnectTimeout(3000);
        connection.setReadTimeout(3000);
        connection.setRequestMethod("GET");

        int code = connection.getResponseCode();

        if (code < 200 || code >= 300) {
            connection.disconnect();
            return null;
        }

        String result = read(connection.getInputStream());

        connection.disconnect();

        return result;
    }

    private static ControlInfo control(
            String location,
            String xml
    ) {

        try {
            Document document =
                    DocumentBuilderFactory
                            .newInstance()
                            .newDocumentBuilder()
                            .parse(
                                    new ByteArrayInputStream(
                                            xml.getBytes(StandardCharsets.UTF_8)
                                    )
                            );

            NodeList services =
                    document.getElementsByTagNameNS("*", "service");

            ControlInfo fallback = null;

            for (int i = 0; i < services.getLength(); i++) {

                Element element =
                        (Element) services.item(i);

                String serviceType =
                        text(element, "serviceType");

                String controlUrl =
                        text(element, "controlURL");

                if (serviceType == null ||
                        controlUrl == null) {
                    continue;
                }

                if (serviceType.contains("WANIPConnection")) {
                    return new ControlInfo(
                            new URL(
                                    new URL(location),
                                    controlUrl
                            ).toString(),
                            serviceType
                    );
                }

                if (serviceType.contains("WANPPPConnection") &&
                        fallback == null) {

                    fallback = new ControlInfo(
                            new URL(
                                    new URL(location),
                                    controlUrl
                            ).toString(),
                            serviceType
                    );
                }
            }

            return fallback;

        } catch (Exception e) {
            return null;
        }
    }

    private static String text(
            Element element,
            String name
    ) {

        NodeList nodes =
                element.getElementsByTagNameNS("*", name);

        if (nodes.getLength() == 0) {
            return null;
        }

        return nodes.item(0)
                .getTextContent()
                .trim();
    }

    private static String localIp() throws Exception {

        for (NetworkInterface networkInterface :
                Collections.list(
                        NetworkInterface.getNetworkInterfaces()
                )) {

            for (InetAddress address :
                    Collections.list(
                            networkInterface.getInetAddresses()
                    )) {

                if (!address.isLoopbackAddress() &&
                        address instanceof Inet4Address) {

                    return address.getHostAddress();
                }
            }
        }

        throw new IOException("sin IPv4 local");
    }

    private static SoapResult soap(
            ControlInfo control,
            String action,
            String args
    ) {

        HttpURLConnection connection = null;

        try {

            String serviceType = control.serviceType;

            String body =
                    "<?xml version=\"1.0\"?>" +
                    "<s:Envelope " +
                    "xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\">" +
                    "<s:Body>" +
                    "<u:" + action +
                    " xmlns:u=\"" + serviceType + "\">" +
                    args +
                    "</u:" + action + ">" +
                    "</s:Body>" +
                    "</s:Envelope>";

            connection =
                    (HttpURLConnection)
                            new URL(control.controlUrl)
                                    .openConnection();

            connection.setDoOutput(true);
            connection.setRequestMethod("POST");
            connection.setConnectTimeout(3000);
            connection.setReadTimeout(3000);

            connection.setRequestProperty(
                    "Content-Type",
                    "text/xml; charset=\"utf-8\""
            );

            connection.setRequestProperty(
                    "SOAPAction",
                    "\"" + serviceType + "#" + action + "\""
            );

            byte[] bytes =
                    body.getBytes(StandardCharsets.UTF_8);

            connection.getOutputStream().write(bytes);

            int code =
                    connection.getResponseCode();

            InputStream stream;

            if (code >= 200 && code < 300) {
                stream = connection.getInputStream();
            } else {
                stream = connection.getErrorStream();

                if (stream == null) {
                    return new SoapResult(
                            false,
                            code,
                            null,
                            "HTTP " + code
                    );
                }
            }

            String response = read(stream);

            boolean success =
                    code >= 200 &&
                    code < 300 &&
                    !containsSoapFault(response);

            return new SoapResult(
                    success,
                    code,
                    response,
                    success
                            ? null
                            : extractSoapError(response)
            );

        } catch (Exception e) {

            return new SoapResult(
                    false,
                    -1,
                    null,
                    e.getClass().getSimpleName() +
                            ": " + safeMessage(e)
            );

        } finally {

            if (connection != null) {
                connection.disconnect();
            }
        }
    }

    private static boolean containsSoapFault(String body) {
        if (body == null) {
            return true;
        }

        String lower = body.toLowerCase();

        return lower.contains("<soap:fault") ||
                lower.contains(":fault") ||
                lower.contains("<fault>");
    }

    private static String extractSoapError(String body) {

        if (body == null || body.trim().isEmpty()) {
            return "Respuesta SOAP vacía";
        }

        String lower = body.toLowerCase();

        int start = lower.indexOf("<errorcode>");

        if (start >= 0) {
            int end = lower.indexOf("</errorcode>", start);

            if (end > start) {
                return "SOAP ErrorCode=" +
                        body.substring(
                                start + 11,
                                end
                        ).trim();
            }
        }

        return "El router rechazó o no confirmó la operación SOAP.";
    }

    private static String buildSoapError(SoapResult result) {

        if (result == null) {
            return "Respuesta SOAP inexistente.";
        }

        if (result.error != null &&
                !result.error.trim().isEmpty()) {

            return result.error;
        }

        if (result.httpCode >= 0) {
            return "HTTP " + result.httpCode;
        }

        return "Operación SOAP no confirmada.";
    }

    private static String read(InputStream input)
            throws Exception {

        if (input == null) {
            return "";
        }

        BufferedReader reader =
                new BufferedReader(
                        new InputStreamReader(
                                input,
                                StandardCharsets.UTF_8
                        )
                );

        StringBuilder result =
                new StringBuilder();

        String line;

        while ((line = reader.readLine()) != null) {
            result.append(line);
        }

        reader.close();

        return result.toString();
    }

    private static long parse(
            String xml,
            String tag
    ) {

        try {

            if (xml == null) {
                return 0;
            }

            String open = "<" + tag + ">";
            String close = "</" + tag + ">";

            int start = xml.indexOf(open);
            int end = xml.indexOf(close);

            if (start >= 0 && end > start) {

                return Long.parseLong(
                        xml.substring(
                                start + open.length(),
                                end
                        ).trim()
                );
            }

        } catch (Exception ignored) {
        }

        return 0;
    }

    private static String safeMessage(Exception e) {

        String message = e.getMessage();

        if (message == null ||
                message.trim().isEmpty()) {

            return "sin detalle";
        }

        return message;
    }
}
