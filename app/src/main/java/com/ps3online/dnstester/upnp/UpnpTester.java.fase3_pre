package com.ps3online.dnstester.upnp;
import android.content.Context;import java.io.*;import java.net.*;import java.util.*;import javax.xml.parsers.*;import org.w3c.dom.*;
public class UpnpTester{
 public static class Result{public String status="NO DETERMINADO",mapping="NO",renewal="NO DETERMINADO",removal="NO DETERMINADO";public long leaseSeconds=0;}
 public static Result test(Context c,long wait){Result r=new Result();int port=45000+new Random().nextInt(1000);try{
  String loc=discover();if(loc==null){r.status="NO DISPONIBLE";return r;}String xml=get(loc);String ctl=control(loc,xml);if(ctl==null)return r;
  String args="<NewRemoteHost></NewRemoteHost><NewExternalPort>"+port+"</NewExternalPort><NewProtocol>UDP</NewProtocol><NewInternalPort>"+port+"</NewInternalPort><NewInternalClient>"+localIp()+"</NewInternalClient><NewEnabled>1</NewEnabled><NewPortMappingDescription>PS3DNSTester</NewPortMappingDescription><NewLeaseDuration>3600</NewLeaseDuration>";
  if(soap(ctl,"AddPortMapping",args)==null){r.status="DISPONIBLE";return r;}r.status="DISPONIBLE";r.mapping="CREADO";
  String q=soap(ctl,"GetSpecificPortMappingEntry","<NewRemoteHost></NewRemoteHost><NewExternalPort>"+port+"</NewExternalPort><NewProtocol>UDP</NewProtocol>");r.leaseSeconds=parse(q,"NewLeaseDuration");
  Thread.sleep(Math.min(wait,15000));r.renewal=soap(ctl,"AddPortMapping",args)!=null?"OK":"NO DETERMINADO";
  r.removal=soap(ctl,"DeletePortMapping","<NewRemoteHost></NewRemoteHost><NewExternalPort>"+port+"</NewExternalPort><NewProtocol>UDP</NewProtocol>")!=null?"OK":"NO DETERMINADO";
 }catch(Exception e){r.status="ERROR: "+e.getMessage();}return r;}
 static String discover()throws Exception{DatagramSocket s=new DatagramSocket();s.setSoTimeout(2500);String m="M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\nMX: 2\r\nST: urn:schemas-upnp-org:device:InternetGatewayDevice:1\r\n\r\n";byte[] b=m.getBytes("UTF-8");s.send(new DatagramPacket(b,b.length,InetAddress.getByName("239.255.255.250"),1900));byte[] z=new byte[4096];DatagramPacket p=new DatagramPacket(z,z.length);try{s.receive(p);}catch(Exception e){s.close();return null;}s.close();for(String x:new String(p.getData(),0,p.getLength(),"UTF-8").split("\r\n"))if(x.toLowerCase().startsWith("location:"))return x.substring(9).trim();return null;}
 static String get(String u)throws Exception{HttpURLConnection x=(HttpURLConnection)new URL(u).openConnection();x.setConnectTimeout(3000);x.setReadTimeout(3000);return read(x.getInputStream());}
 static String control(String loc,String xml){try{Document d=DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new ByteArrayInputStream(xml.getBytes("UTF-8")));NodeList n=d.getElementsByTagNameNS("*","service");for(int i=0;i<n.getLength();i++){Element e=(Element)n.item(i);String st=text(e,"serviceType"),cu=text(e,"controlURL");if(st!=null&&st.contains("WANIPConnection")&&cu!=null)return new URL(new URL(loc),cu).toString();}}catch(Exception e){}return null;}
 static String text(Element e,String t){NodeList n=e.getElementsByTagNameNS("*",t);return n.getLength()==0?null:n.item(0).getTextContent();}
 static String localIp()throws Exception{for(NetworkInterface ni:Collections.list(NetworkInterface.getNetworkInterfaces()))for(InetAddress a:Collections.list(ni.getInetAddresses()))if(!a.isLoopbackAddress()&&a instanceof Inet4Address)return a.getHostAddress();throw new IOException("sin IPv4");}
 static String soap(String u,String a,String args){try{String body="<?xml version=\"1.0\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body><u:"+a+" xmlns:u=\"urn:schemas-upnp-org:service:WANIPConnection:1\">"+args+"</u:"+a+"></s:Body></s:Envelope>";HttpURLConnection x=(HttpURLConnection)new URL(u).openConnection();x.setDoOutput(true);x.setRequestMethod("POST");x.setConnectTimeout(3000);x.setReadTimeout(3000);x.setRequestProperty("Content-Type","text/xml; charset=\"utf-8\"");x.setRequestProperty("SOAPAction","\"urn:schemas-upnp-org:service:WANIPConnection:1#"+a+"\"");x.getOutputStream().write(body.getBytes("UTF-8"));int c=x.getResponseCode();return c>=200&&c<300?read(x.getInputStream()):null;}catch(Exception e){return null;}}
 static String read(InputStream i)throws Exception{BufferedReader r=new BufferedReader(new InputStreamReader(i));StringBuilder b=new StringBuilder();String x;while((x=r.readLine())!=null)b.append(x);return b.toString();}
 static long parse(String x,String t){try{if(x==null)return 0;int a=x.indexOf("<"+t+">"),b=x.indexOf("</"+t+">");return a>=0&&b>a?Long.parseLong(x.substring(a+t.length()+2,b).trim()):0;}catch(Exception e){return 0;}}
}
