    /**
     * Convierte endpoint a texto.
     */
    private String endpointToString(
            InetSocketAddress endpoint
    ) {

        if (endpoint == null) {
            return "";
        }

        if (endpoint.getAddress() == null) {
            return endpoint.toString();
        }

        return endpoint.getAddress()
                .getHostAddress()
                + ":"
                + endpoint.getPort();
    }

    /**
     * Mensaje seguro para evitar null.
     */
    private String safeMessage(
            Throwable throwable
    ) {

        if (throwable == null) {
            return "error desconocido";
        }

        String message =
                throwable.getMessage();

        if (
                message == null
                        || message.trim().isEmpty()
        ) {
            return throwable
                    .getClass()
                    .getSimpleName();
        }

        return message;
    }

    /**
     * Envía información al callback de la interfaz.
     */
    private void emit(
            String message
    ) {

        try {

            out.accept(message);

        } catch (Exception ignored) {
        }
    }
