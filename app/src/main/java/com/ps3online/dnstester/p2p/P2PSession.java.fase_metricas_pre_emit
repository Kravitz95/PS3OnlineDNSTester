package com.ps3online.dnstester.p2p;

import android.content.Context;

import com.ps3online.dnstester.stun.StunP2P;

import org.json.JSONObject;

import java.net.DatagramPacket;
import java.net.DatagramSocket;
import java.net.InetSocketAddress;
import java.net.SocketTimeoutException;
import java.nio.ByteBuffer;
import java.nio.charset.StandardCharsets;
import java.util.Locale;
import java.util.Map;
import java.util.Set;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.TimeUnit;
import java.util.function.Consumer;

import okhttp3.OkHttpClient;
import okhttp3.Request;
import okhttp3.Response;
import okhttp3.WebSocket;
import okhttp3.WebSocketListener;

/**
 * P2P experimental para PS3 ONLINE CONNECT.
 *
 * Flujo:
 *
 * HOST:
 * Android -> STUN -> WebSocket -> CREATE ROOM
 *
 * JOIN:
 * Android -> STUN -> WebSocket -> JOIN ROOM
 *
 * Después:
 * intercambio de endpoints públicos
 * -> UDP hole punching bidireccional
 * -> medición de tráfico
 * -> latencia
 * -> pérdida
 * -> chat mediante señalización
 *
 * IMPORTANTE:
 * Esto prueba condiciones de conectividad compatibles con
 * escenarios P2P de PS3. No convierte Android en una PS3.
 */
public class P2PSession {

    private static final String DEFAULT_WS_URL =
            "wss://ps3-online-connect-signaling.onrender.com";

    private static final String STUN_HOST =
            "stun.cloudflare.com";

    private static final int STUN_PORT = 3478;

    private static final int STUN_TIMEOUT_MS = 6000;

    private static final int UDP_TEST_DURATION_MS = 20000;

    private static final int UDP_SEND_INTERVAL_MS = 100;

    private static final int UDP_RECEIVE_TIMEOUT_MS = 250;

    private static final int MAGIC = 0x50533350;

    private final String wsUrl;
    private final String initialRoom;
    private final boolean host;
    private final String dns;
    private final String info;
    private final Context ctx;
    private final Consumer<String> out;

    private OkHttpClient client;
    private WebSocket ws;

    private DatagramSocket udp;

    private InetSocketAddress publicEndpoint;
    private InetSocketAddress peer;

    private String room = "";
    private String role = "";

    private volatile boolean running = false;
    private volatile boolean p2pRunning = false;

    // 📡 Estadísticas generales UDP
private volatile long sentPackets = 0;
private volatile long receivedPackets = 0;

private volatile long sentBytes = 0;
private volatile long receivedBytes = 0;

// 📦 DATA
private volatile long dataOut = 0;
private volatile long dataIn = 0;
private volatile long dataBytesOut = 0;
private volatile long dataBytesIn = 0;

// ✅ ACK
private volatile long ackOut = 0;
private volatile long ackIn = 0;
private volatile long ackBytesOut = 0;
private volatile long ackBytesIn = 0;

// ⏱️ RTT medido mediante ACK
private volatile long rttSamples = 0;
private volatile long rttTotalMs = 0;
    
private final Map<Integer, Long> pendingPackets =
        new ConcurrentHashMap<>();

private final Set<Integer> receivedDataSequences =
        ConcurrentHashMap.newKeySet();

private final Set<Integer> acknowledgedSequences =
        ConcurrentHashMap.newKeySet();

private Thread udpThread;

    public P2PSession(
            String u,
            String r,
            boolean h,
            String d,
            String i,
            Context c,
            Consumer<String> o
    ) {
        wsUrl = (u == null || u.trim().isEmpty())
                ? DEFAULT_WS_URL
                : u.trim();

        initialRoom = r == null
                ? ""
                : r.trim().toUpperCase(Locale.US);

        host = h;
        dns = d == null ? "" : d;
        info = i == null ? "" : i;
        ctx = c;
        out = o == null
                ? message -> {}
                : o;
    }

    /**
     * Constructor simplificado.
     */
    public P2PSession(
            boolean h,
            String r,
            String d,
            String i,
            Context c,
            Consumer<String> o
    ) {
        this(
                DEFAULT_WS_URL,
                r,
                h,
                d,
                i,
                c,
                o
        );
    }

    /**
     * Inicia STUN + señalización.
     */
    public void start() {

        if (running) {
            emit("⚠️ Ya existe una sesión P2P.");
            return;
        }

        running = true;

        Thread startupThread = new Thread(
                () -> {
                    try {
                        startInternal();
                    } catch (Exception e) {
                        emit(
                                "🔴 P2P: "
                                        + safeMessage(e)
                        );
                        close();
                    }
                },
                "p2p-start"
        );

        startupThread.start();
    }

    private void startInternal() throws Exception {

        emit("🔎 INICIANDO DIAGNÓSTICO P2P...");
        emit("🌐 Servidor: " + wsUrl);

        /*
         * =====================================================
         * 1. STUN
         * =====================================================
         */

        emit("📡 STUN: buscando endpoint público...");

        StunP2P.Result st =
                StunP2P.discover(
                        STUN_HOST,
                        STUN_PORT,
                        STUN_TIMEOUT_MS
                );

        if (!st.ok) {

            running = false;

            emit(
                    "🔴 STUN: "
                            + st.message
            );

            throw new Exception(
                    "STUN no respondió"
            );
        }

        /*
         * IMPORTANTE:
         *
         * El socket y el endpoint pertenecen al mismo
         * descubrimiento STUN.
         *
         * NO creamos otro Result artificial.
         */

        udp = st.socket;
        publicEndpoint = st.mapped;

        emit(
                "🟢 STUN: "
                        + st.message
        );

        if (publicEndpoint == null) {

            throw new Exception(
                    "STUN no devolvió endpoint público"
            );
        }

        emit(
                "🌐 Endpoint público: "
                        + endpointToString(publicEndpoint)
        );

        /*
         * =====================================================
         * 2. WEBSOCKET
         * =====================================================
         */

        emit(
                "🔌 Conectando señalización..."
        );

        client =
                new OkHttpClient.Builder()
                        .pingInterval(
                                25,
                                TimeUnit.SECONDS
                        )
                        .build();

        Request request =
                new Request.Builder()
                        .url(wsUrl)
                        .build();

        ws =                client.newWebSocket(
                        request,
                        new WebSocketListener() {

                            @Override
                            public void onOpen(
                                    WebSocket webSocket,
                                    Response response
                            ) {

                                P2PSession.this.ws =
                                        webSocket;

                                emit(
                                        "🟢 SEÑALIZACIÓN: conectada"
                                );

                                try {

                                    JSONObject message =
                                            new JSONObject();

                                    if (host) {

                                        message.put(
                                                "type",
                                                "create"
                                        );

                                        role = "host";

                                        emit(
                                                "🏠 CREANDO SALA..."
                                        );

                                    } else {

                                        message.put(
                                                "type",
                                                "join"
                                        );

                                        message.put(
                                                "room",
                                                initialRoom
                                        );

                                        role = "guest";

                                        emit(
                                                "🚪 UNIÉNDOSE A SALA: "
                                                        + initialRoom
                                        );
                                    }

                                    webSocket.send(
                                            message.toString()
                                    );

                                } catch (Exception e) {

                                    emit(
                                            "🔴 SEÑAL: "
                                                    + safeMessage(e)
                                    );
                                }
                            }

                            @Override
                            public void onMessage(
                                    WebSocket webSocket,
                                    String text
                            ) {

                                handleSignalMessage(
                                        text
                                );
                            }

                            @Override
                            public void onClosing(
                                    WebSocket webSocket,
                                    int code,
                                    String reason
                            ) {

                                emit(
                                        "⚠️ SEÑALIZACIÓN cerrando: "
                                                + reason
                                );
                            }

                            @Override
                            public void onClosed(
                                    WebSocket webSocket,
                                    int code,
                                    String reason
                            ) {

                                emit(
                                        "🔌 SEÑALIZACIÓN cerrada"
                                );
                            }

                            @Override
                            public void onFailure(
                                    WebSocket webSocket,
                                    Throwable t,
                                    Response response
                            ) {

                                emit(
                                        "🔴 WEBSOCKET: "
                                                + safeMessage(t)
                                );
                            }
                        }
                );
    }

    /**
     * Procesa mensajes del servidor de señalización.
     */
    private void handleSignalMessage(
            String text
    ) {

        try {

            JSONObject message =
                    new JSONObject(text);

            String type =
                    message.optString(
                            "type",
                            ""
                    );

            /*
             * Servidor conectado.
             */

            if (type.equals("connected")) {

                emit(
                        "🟢 SERVIDOR: "
                                + message.optString(
                                        "message",
                                        "conectado"
                                )
                );

                return;
            }

            /*
             * Sala creada o unión aceptada.
             */

            if (type.equals("room")) {

                room =
                        message.optString(
                                "room",
                                ""
                        );

                role =
                        message.optString(
                                "role",
                                role
                        );

                emit(
                        "🏠 SALA: "
                                + room
                );

                if (role.equals("host")) {

                    emit(
                            "📱 Comparte este código con el otro móvil:"
                    );

                    emit(
                            "🔑 "
                                    + room
                    );

                } else {

                    emit(
                            "🟢 UNIDO A LA SALA: "
                                    + room
                    );
                }

                /*
                 * Después de obtener la sala enviamos
                 * nuestro endpoint público.
                 */

                sendHello();

                return;
            }

            /*
             * El servidor avisa al host que llegó
             * el segundo móvil.
             */

            if (type.equals("peer_joined")) {

                emit(
                        "👥 SEGUNDO MÓVIL CONECTADO A LA SALA"
                );

                sendHello();

                return;
            }

            /*
             * Endpoint público del otro móvil.
             */

            if (type.equals("peer")) {

                String ip =
                        message.optString(
                                "ip",
                                ""
                        );

                int port =
                        message.optInt(
                                "port",
                                0
                        );

                if (
                        ip.isEmpty()
                                || port <= 0
                ) {

                    emit(
                            "⚠️ PEER: endpoint inválido"
                    );

                    return;
                }

                peer =
                        new InetSocketAddress(
                                ip,
                                port
                        );

                emit(
                        "🌐 PEER: "
                                + endpointToString(
                                        peer
                                )
                );

                String peerInfo =
                        message.optString(
                                "info",
                                ""
                        );

                if (!peerInfo.isEmpty()) {

                    emit(
                            "ℹ️ INFO PEER: "
                                    + peerInfo
                    );
                }

                startUdpHolePunching();

                return;
            }

            /*
             * Chat recibido.
             */

            if (type.equals("chat")) {

                String messageText =
                        message.optString(
                                "message",
                                ""
                        );

                emit(
                        "💬 PEER: "
                                + messageText
                );

                return;
            }

            /*
             * Mensaje de señalización.
             */

            if (type.equals("signal")) {

                emit(
                        "📡 SIGNAL: "
                                + message.optString(
                                        "message",
                                        ""
                                )
                );

                return;
            }

            /*
             * El otro móvil salió.
             */

            if (type.equals("peer_left")) {

                emit(
                        "⚠️ PEER: "
                                + message.optString(
                                        "message",
                                        "El otro móvil salió."
                                )
                );

                peer = null;

                return;
            }

            /*
             * Error enviado por el servidor.
             */

            if (type.equals("error")) {

                emit(
                        "🔴 SERVIDOR: "
                                + message.optString(
                                        "message",
                                        "Error desconocido."
                                )
                );

                return;
            }

            /*
             * Pong de señalización.
             */

            if (type.equals("pong")) {

                emit(
                        "🏓 WEBSOCKET: PONG"
                );

                return;
            }

        } catch (Exception e) {

            emit(
                    "⚠️ SEÑAL inválida: "
                            + safeMessage(e)
            );
        }
    }

    /**
     * Envía nuestro endpoint público al servidor.
     */
    private void sendHello() {

        if (ws == null) {
            return;
        }

        if (udp == null) {
            return;
        }

        if (publicEndpoint == null) {

            emit(
                    "🔴 HELLO: endpoint público no disponible"
            );

            return;
        }

        sendHelloWithEndpoint();
    }

    /**
     * Construye el mensaje hello.
     */
    private void sendHelloWithEndpoint() {

        if (
                ws == null
                        || publicEndpoint == null
        ) {
            return;
        }

        try {

            JSONObject hello =
                    new JSONObject();

            hello.put(
                    "type",
                    "hello"
            );

            hello.put(
                    "room",
                    room
            );

            hello.put(
                    "role",
                    role
            );

            hello.put(
                    "endpoint",
                    endpointToString(
                            publicEndpoint
                    )
            );

            hello.put(
                    "info",
                    info
            );

            hello.put(
                    "dns",
                    dns
            );

            boolean sent =
                    ws.send(
                            hello.toString()
                    );

            if (sent) {

                emit(
                        "📡 HELLO: endpoint enviado"
                );

            } else {

                emit(
                        "⚠️ HELLO: no se pudo enviar"
                );
            }

        } catch (Exception e) {

            emit(
                    "⚠️ HELLO: "
                            + safeMessage(e)
            );
        }
    }

    /**
     * Inicia UDP hole punching.
     *
     * Ambos móviles envían paquetes durante la misma ventana.
     * Esto es importante porque un NAT puede necesitar tráfico
     * saliente antes de aceptar tráfico entrante relacionado.
     */
    private synchronized void startUdpHolePunching() {

        if (p2pRunning) {
            return;
        }

        if (udp == null) {

            emit(
                    "🔴 UDP: socket no disponible"
            );

            return;
        }

        if (peer == null) {

            emit(
                    "🔴 UDP: peer no disponible"
            );

            return;
        }

        p2pRunning = true;

        sentPackets = 0;
        receivedPackets = 0;

        sentBytes = 0;
        receivedBytes = 0;

        rttSamples = 0;
        rttTotalMs = 0;

        pendingPackets.clear();
        receivedDataSequences.clear();
        acknowledgedSequences.clear();

        emit(
                "🕳️ UDP P2P: iniciando hole punching..."
        );

        emit(
                "🎯 Destino: "
                        + endpointToString(peer)
        );

        udpThread =
                new Thread(
                        this::runUdpTest,
                        "p2p-udp-test"
                );

        udpThread.start();
    }

    /**
     * Prueba bidireccional UDP.
     */
    private void runUdpTest() {

        final long endTime =
                System.currentTimeMillis()
                        + UDP_TEST_DURATION_MS;

        try {

            udp.setSoTimeout(
                    UDP_RECEIVE_TIMEOUT_MS
            );

            /*
             * Thread receptor/envío combinado.
             *
             * Cada móvil:
             * - envía DATA
             * - recibe DATA
             * - responde ACK
             * - mide RTT
             */

            int sequence = 0;

            byte[] receiveBuffer =
                    new byte[512];

            while (
                    running
                            && System.currentTimeMillis()
                            < endTime
            ) {

                /*
                 * Enviar varios paquetes para mantener
                 * abierta la traducción NAT.
                 */

                int dataSequence = sequence++;

                byte[] packet =
                        createDataPacket(
                                dataSequence
                        );

                /*
                 * Registrar el instante local ANTES de enviar DATA.
                 * El ACK utilizará este mismo sequence para calcular RTT.
                 */
                long sendNano = System.nanoTime();
                pendingPackets.put(dataSequence, sendNano);

                DatagramPacket outgoing =
                        new DatagramPacket(
                                packet,
                                packet.length,
                                peer.getAddress(),
                                peer.getPort()
                        );

                udp.send(outgoing);

                sentPackets++;
                sentBytes += packet.length;

                /*
                 * Escuchar respuestas.
                 */

                long receiveUntil =
                        System.currentTimeMillis()
                                + UDP_SEND_INTERVAL_MS;

                while (
                        System.currentTimeMillis()
                                < receiveUntil
                                && running
                ) {

                    try {

                        DatagramPacket incoming =
                                new DatagramPacket(
                                        receiveBuffer,
                                        receiveBuffer.length
                                );

                        udp.receive(incoming);

                        processUdpPacket(
                                incoming
                        );

                    } catch (
                            SocketTimeoutException ignored
                    ) {

                        break;
                    }
                }

                Thread.sleep(
                        UDP_SEND_INTERVAL_MS
                );
            }

            /*
             * Ventana final de recepción.
             *
             * Permitimos que lleguen los últimos
             * paquetes enviados por el peer.
             */

            long finalWindow =
                    System.currentTimeMillis()
                            + 1500;

            while (
                    running
                            && System.currentTimeMillis()
                            < finalWindow
            ) {

                try {

                    DatagramPacket incoming =
                            new DatagramPacket(
                                    receiveBuffer,
                                    receiveBuffer.length
                            );

                    udp.receive(incoming);

                    processUdpPacket(
                            incoming
                    );

                } catch (
                        SocketTimeoutException ignored
                ) {

                    // continuar hasta finalizar
                }
            }

            emitUdpResult();

        } catch (Exception e) {

            emit(
                    "🔴 UDP: "
                            + safeMessage(e)
            );

        } finally {

            /*
             * Los DATA sin ACK ya no pueden producir RTT
             * después de finalizar esta prueba.
             */
            pendingPackets.clear();
            p2pRunning = false;
        }
    }

    /**
     * Crea un paquete de prueba.
     *
     * Estructura:
     *
     * 4 bytes  MAGIC
     * 4 bytes  TYPE
     * 4 bytes  SEQUENCE
     * 8 bytes  TIMESTAMP
     */
    private byte[] createDataPacket(
            int sequence
    ) {

        ByteBuffer buffer =
                ByteBuffer.allocate(20);

        buffer.putInt(MAGIC);

        /*
         * TYPE 1 = DATA
         */
        buffer.putInt(1);

        buffer.putInt(sequence);

        buffer.putLong(
                System.nanoTime()
        );

        return buffer.array();
    }

    /**
     * Procesa un paquete UDP recibido.
     */
    private void processUdpPacket(
            DatagramPacket packet
    ) {
        try {
            if (packet == null ||
                    packet.getLength() < 20 ||
                    udp == null ||
                    peer == null) {
                return;
            }

            /*
             * Solo aceptar paquetes procedentes del endpoint
             * del peer conocido.
             */
            if (packet.getAddress() == null ||
                    peer.getAddress() == null ||
                    !packet.getAddress().equals(peer.getAddress()) ||
                    packet.getPort() != peer.getPort()) {
                return;
            }

            ByteBuffer buffer =
                    ByteBuffer.wrap(
                            packet.getData(),
                            packet.getOffset(),
                            packet.getLength()
                    );

            int magic = buffer.getInt();

            if (magic != MAGIC) {
                return;
            }

            int type = buffer.getInt();
            int sequence = buffer.getInt();
            long timestamp = buffer.getLong();

            /*
             * TYPE 1 = DATA recibido del peer.
             */
            if (type == 1) {

                /*
                 * Evitar contar dos veces el mismo DATA.
                 */
                if (!receivedDataSequences.add(sequence)) {
                    return;
                }

                dataIn++;
                dataBytesIn += packet.getLength();

                receivedPackets++;
                receivedBytes += packet.getLength();

                /*
                 * Responder con ACK al mismo endpoint.
                 */
                byte[] ack =
                        createAckPacket(
                                sequence,
                                timestamp
                        );

                DatagramPacket response =
                        new DatagramPacket(
                                ack,
                                ack.length,
                                packet.getAddress(),
                                packet.getPort()
                        );

                udp.send(response);

                ackOut++;
                ackBytesOut += ack.length;

                

                return;
            }

            /*
             * TYPE 2 = ACK de un DATA enviado por este teléfono.
             */
            if (type == 2) {

                /*
                 * El ACK debe corresponder a un DATA
                 * pendiente enviado localmente.
                 */
                Long sendNano =
                        pendingPackets.remove(sequence);

                if (sendNano == null) {
                    return;
                }

                /*
                 * Evitar contabilizar dos veces el mismo ACK.
                 */
                if (!acknowledgedSequences.add(sequence)) {
                    return;
                }

                ackIn++;
                ackBytesIn += packet.getLength();

                

                /*
                 * RTT correcto:
                 * envío local -> recepción local del ACK.
                 *
                 * No se utiliza el timestamp del otro teléfono
                 * porque System.nanoTime() no es comparable entre
                 * dispositivos.
                 */
                long elapsedNanos =
                        System.nanoTime() - sendNano;

                if (elapsedNanos >= 0) {

                    long rtt =
                            TimeUnit.NANOSECONDS.toMillis(
                                    elapsedNanos
                            );

                    if (rtt >= 0 && rtt < 10000) {
                        rttSamples++;
                        rttTotalMs += rtt;
                    }
                }
            }

        } catch (Exception e) {
            emit(
                    "⚠️ UDP paquete inválido: "
                            + safeMessage(e)
            );
        }
    }

    /**
     * Crea ACK.
     */
    private byte[] createAckPacket(
            int sequence,
            long originalTimestamp
    ) {

        ByteBuffer buffer =
                ByteBuffer.allocate(20);

        buffer.putInt(MAGIC);

        /*
         * TYPE 2 = ACK
         */
        buffer.putInt(2);

        buffer.putInt(sequence);

        buffer.putLong(
                originalTimestamp
        );

        return buffer.array();
    }

    /**
     * Genera el resultado final del experimento UDP.
     */
    private void emitUdpResult() {

        long packetsOut =
                sentPackets;

        long packetsIn =
                receivedPackets;

        double loss = 0.0;

        /*
         * Como ambos lados generan tráfico,
         * no usamos simplemente received/sent
         * como una verdad absoluta de pérdida.
         *
         * Lo presentamos como una observación
         * del experimento.
         */

        if (packetsOut > 0) {

            loss =
                    100.0
                            * (
                            1.0
                                    - (
                                    (double) packetsIn
                                            / (double) packetsOut
                            )
                    );

            if (loss < 0) {
                loss = 0;
            }

            if (loss > 100) {
                loss = 100;
            }
        }

        double averageRtt = 0.0;

        if (rttSamples > 0) {

            averageRtt =
                    (double) rttTotalMs
                            / (double) rttSamples;
        }

        emit(
                "📊 P2P UDP: enviados="
                        + packetsOut
                        + " recibidos="
                        + packetsIn
        );

        emit(
                String.format(
                        Locale.US,
                        "📉 PÉRDIDA OBSERVADA: %.1f%%",
                        loss
                )
        );

        if (rttSamples > 0) {

            emit(
                    String.format(
                            Locale.US,
                            "⏱️ LATENCIA OBSERVADA: %.0f ms",
                            averageRtt
                    )
            );

        } else {

            emit(
                    "⏱️ LATENCIA: NO DETERMINADA"
            );
        }

        /*
         * Interpretación conservadora.
         */

        if (
                packetsIn > 0
                        && rttSamples > 0
        ) {

            if (loss <= 5.0) {

                emit(
                        "🟢 RESULTADO P2P: CONECTIVIDAD BIDIRECCIONAL CONFIRMADA"
                );

            } else {

                emit(
                        "🟡 RESULTADO P2P: CONECTIVIDAD BIDIRECCIONAL CON PÉRDIDA"
                );
            }

        } else if (packetsIn > 0) {

            emit(
                    "🟡 RESULTADO P2P: TRÁFICO RECIBIDO, LATENCIA NO DETERMINADA"
            );

        } else {

            emit(
                    "⚠️ RESULTADO P2P: NO DETERMINADO — no se recibió tráfico UDP"
            );
        }
    }

    /**
     * Envía un mensaje de chat mediante el servidor
     * de señalización.
     */
    public boolean sendChat(
            String message
    ) {

        if (
                ws == null
                        || message == null
                        || message.trim().isEmpty()
        ) {
            return false;
        }

        try {

            JSONObject object =
                    new JSONObject();

            object.put(
                    "type",
                    "chat"
            );

            object.put(
                    "message",
                    message.trim()
            );

            boolean result =
                    ws.send(
                            object.toString()
                    );

            if (result) {

                emit(
                        "💬 TÚ: "
                                + message.trim()
                );
            }

            return result;

        } catch (Exception e) {

            emit(
                    "⚠️ CHAT: "
                            + safeMessage(e)
            );

            return false;
        }
    }

    /**
     * Envía un ping de señalización.
     */
    public boolean sendSignalPing() {

        if (ws == null) {
            return false;
        }

        try {

            JSONObject object =
                    new JSONObject();

            object.put(
                    "type",
                    "ping"
            );

            return ws.send(
                    object.toString()
            );

        } catch (Exception e) {

            emit(
                    "⚠️ PING: "
                            + safeMessage(e)
            );

            return false;
        }
    }

    /**
     * Cierra completamente la sesión.
     */
    public synchronized void close() {

        running = false;
        p2pRunning = false;

        if (udpThread != null) {

            udpThread.interrupt();
            udpThread = null;
        }

        if (udp != null) {

            try {
                udp.close();
            } catch (Exception ignored) {
            }

            udp = null;
        }

        if (ws != null) {

            try {
                ws.close(
                        1000,
                        "Sesión finalizada"
                );
            } catch (Exception ignored) {
            }

            ws = null;
        }

        if (client != null) {

            try {
                client.dispatcher()
                        .executorService()
                        .shutdown();

            } catch (Exception ignored) {
            }

            client = null;
        }

        peer = null;
        publicEndpoint = null;

        emit(
                "🧹 P2P: sesión cerrada"
        );
    }

